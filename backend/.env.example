# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas connection string in production)
MONGO_URI=mongodb://localhost:27017/farm_market

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# 2Factor.in OTP API (https://2factor.in)
# NEVER commit your real key. This file only holds placeholders.
TWO_FACTOR_API_KEY=your_actual_key_here
TWO_FACTOR_BASE_URL=https://2factor.in/API/V1

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
